{
  "name": "jspsi",
  "version": "0.0.0",
  "description": "JavaScript implementation of private set intersection for record linkage.",
  "license": "Apache-2.0",
  "author": "Vincent Dorie <vdorie@gmail.com>",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "node scripts/dev.mjs",
    "dev:console": "node scripts/dev.mjs dev:console",
    "lint": "eslint .",
    "format": "prettier --write .",
    "formatcheck": "prettier --list-different .",
    "linkcheck": "node scripts/check-doc-links.mjs",
    "check:all": "node scripts/run-checks.mjs",
    "check:contributing": "node scripts/check-contributing-scope.mjs",
    "check:claudemd-budget": "node scripts/check-claudemd-budget.mjs",
    "check:comment-narration": "node scripts/check-comment-history-narration.mjs",
    "check:pr-checklist": "node scripts/check-pr-checklist.mjs",
    "check:command-inventory": "node scripts/check-command-inventory.mjs",
    "check:image-capabilities": "node scripts/assert-image-capabilities.mjs --coverage",
    "check:enforcement-claims": "node scripts/check-enforcement-claims.mjs",
    "check:egress-claims": "node scripts/check-egress-claims.mjs",
    "check:workflow-agent-models": "node scripts/check-workflow-agent-models.mjs",
    "check:workflow-args-resolve": "node scripts/check-workflow-args-resolve.mjs",
    "check:action-pin-drift": "node scripts/check-action-pin-drift.mjs",
    "check:checkout-ref-override": "node scripts/check-checkout-ref-override.mjs",
    "check:merge-gate-identities": "node scripts/check-merge-gate-identities.mjs",
    "check:dependabot-ignore-shape": "node scripts/check-dependabot-ignore-shape.mjs",
    "check:dependabot-pin-coverage": "node scripts/check-dependabot-pin-coverage.mjs",
    "check:brace-expansion-override": "node scripts/check-brace-expansion-override.mjs",
    "check:crossws-sbom-block": "node scripts/check-crossws-sbom-block.mjs",
    "check:nested-root-package": "node scripts/check-nested-root-package.mjs",
    "check:deploy-trigger-graph": "node scripts/check-deploy-trigger-graph.mjs",
    "check:routetree": "node scripts/check-routetree-fresh.mjs",
    "check:web-config-native-load": "node scripts/check-web-config-native-load.mjs",
    "check:nitro-websocket-unset": "node scripts/check-nitro-websocket-unset.mjs",
    "check:core-barrel-wildcards": "node scripts/check-core-barrel-wildcards.mjs",
    "check:vectors": "node scripts/check-vectors-generators.mjs",
    "check:protocol-version-bump": "node scripts/check-protocol-version-bump.mjs",
    "check:exchange-record-version": "node scripts/check-exchange-record-version.mjs",
    "check:stun-default-claims": "node scripts/check-stun-default-claims.mjs",
    "check:webrtc-provider-options-unread": "node scripts/check-webrtc-provider-options-unread.mjs",
    "check:run-failure-sink": "node scripts/check-run-failure-sink.mjs",
    "check:zero-setup-keys": "node scripts/check-zero-setup-keys.mjs",
    "check:built-in-set-versions": "node scripts/check-built-in-set-versions.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "check:release-signing": "node scripts/check-release-signing.mjs",
    "check:prebuild-provenance": "node scripts/verify-prebuild-provenance.mjs",
    "audit:production": "node scripts/npm-audit-retry.mjs",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/peerjs-broker/tsconfig.json && tsc -p apps/cli/tsconfig.test.json && tsc -p apps/web/tsconfig.json",
    "test": "npm run test -w packages/core -w apps/cli -w apps/web",
    "test:scripts": "vitest run --project scripts --project repo-scripts --project hooks --project harness",
    "test:mutation": "node scripts/stryker-security.mjs",
    "coverage": "npm run coverage -w packages/core -w apps/cli -w apps/web",
    "measure:pr-checks": "node .claude/scripts/measure-pr-checks.mjs"
  },
  "keywords": [
    "private set intersection",
    "record linkage"
  ],
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true,
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "fsevents@2.3.2 || 2.3.3": false
  }
}
