# The FIPS variant image: the same two-stage build as the root Dockerfile, on
# Amazon Linux 2023 instead of Alpine, carrying the CMVP-validated OpenSSL FIPS
# provider AWS publishes for that distribution. It is a separate artifact from
# the default image, which stays on node:26-alpine; see
# docs/notes/fips-variant-image.md for what may and may not be claimed of it and
# for what does not work in it.
#
# Both stages share the same Amazon Linux base so the production `npm ci` runs
# on the same glibc userland the runtime stage has: @openmined/psi.js ships
# separate musl and glibc prebuilds, so building on one libc and running on the
# other is not safe.
#
# The deployment profile is one build-time source of truth shared by both
# stages, exactly as in the root Dockerfile.
ARG VITE_DEPLOYMENT_PROFILE=console

# Amazon Linux 2023 packages nodejs20, nodejs22 and nodejs24 only, and the root
# package.json requires >=26, so the runtime comes from the official tarball.
# The per-architecture sha256 the tarball is checked against is committed below
# and covers this release's bytes only, so a Node bump moves this version and
# both of those hashes together.
ARG NODE_VERSION=v26.7.0

# The Amazon Linux release snapshot every dnf transaction below resolves
# against. AWS retains superseded NVRs -- both certified provider packages are
# still served by every snapshot since they first appeared -- so pinning the
# snapshot as well as the package NVR is what makes the provider layer
# reproducible rather than a function of the build date.
ARG AL2023_RELEASEVER=2023.12.20260727

# CMVP certificate 5021. The package and version pin which build is installed;
# the module version string is what the module itself reports. Ten NVRs share
# the openssl-fips-provider-latest package name with ten different modules, only
# one of them certified, so a package name alone proves nothing. Both are
# asserted against the built image below, and a mismatch fails the build.
ARG FIPS_PROVIDER_PACKAGE=openssl-fips-provider-certified
ARG FIPS_PROVIDER_VERSION=3.0.8-1.amzn2023.0.1
ARG FIPS_MODULE_VERSION=3.0.8-d694bfa693b76001

# The multi-arch index digest, not a platform-specific manifest digest, so both
# architectures resolve. The rootfs it names carries the release
# AL2023_RELEASEVER names, which is the coupling this pin is for and which the
# assertion in the stage below holds rather than this comment. Where the digest
# was resolved, and the checklist a bump of it works through, are in
# docs/spec/DEPENDENCY_PINS.md.
FROM amazonlinux:2023@sha256:694092ae18877ed4e3cb9b643759ba95df1f12af12528fefa18f60f79d4c1568 AS nodebase
ARG NODE_VERSION
ARG AL2023_RELEASEVER
# The coupling the digest above is pinned for, asserted rather than described:
# the rootfs this stage runs on and the snapshot every dnf transaction below
# resolves against must be one Amazon Linux release. A digest bump moves the
# rootfs and nothing else, so without this the userland comes from one release
# and the package layer from another in a build that stays green. Both stages
# below build FROM this one, so the assertion covers the whole image, and it
# fails the build until AL2023_RELEASEVER moves in the same diff. It speaks for
# the architecture being built only, each of which has its own rootfs.
RUN set -eux; \
  base_release="$(rpm -q --qf '%{VERSION}' system-release)"; \
  echo "base rootfs release: ${base_release}"; \
  test "${base_release}" = "${AL2023_RELEASEVER}"
# libatomic is the one shared library the stock Amazon Linux 2023 image lacks for
# the official Node binary: without it node exits 127 on a missing
# libatomic.so.1. tar, gzip and xz unpack the tarball below.
RUN dnf -y --releasever=${AL2023_RELEASEVER} install tar gzip xz findutils libatomic && dnf clean all
# The tarball is checked against a sha256 committed here rather than against the
# release's own SHASUMS256.txt, which would arrive over the same channel as the
# bytes it vouches for. Each hash is a literal in this RUN and deliberately not
# an ARG: an ARG moves with --build-arg alongside the artifact it is meant to
# hold, which checks nothing. Where the two values came from, and what the
# provenance act behind them does and does not establish, are in
# docs/notes/fips-variant-image.md.
#
# That this check fails closed -- on bytes that do not match, and on the arch
# selection pairing a tarball with the other architecture's hash -- is driven
# against the real sha256sum in scripts/docker-entrypoint-fips.test.mjs.
RUN set -eux; \
  arch="$(uname -m)"; \
  case "$arch" in \
  x86_64) node_arch=x64; node_sha256=982aa24dd8be4c889c6a8ab337ddff3b0896645b20f4239356e80552c16277ee ;; \
  aarch64) node_arch=arm64; node_sha256=afc7a004018485092ac8985b817b0d5684472bd9472e0b57d2ab88737e50090d ;; \
  *) echo "unsupported architecture $arch" >&2; exit 1 ;; \
  esac; \
  cd /tmp; \
  curl -fsSLO "https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
  echo "${node_sha256}  node-${NODE_VERSION}-linux-${node_arch}.tar.xz" | sha256sum -c -; \
  mkdir -p /opt/node; \
  tar -xJf "node-${NODE_VERSION}-linux-${node_arch}.tar.xz" -C /opt/node --strip-components=1; \
  rm -f "node-${NODE_VERSION}-linux-${node_arch}.tar.xz"
ENV PATH=/opt/node/bin:$PATH
RUN node --version && npm --version

FROM nodebase AS builder

WORKDIR /build

COPY .npmrc package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/peerjs-broker/package.json packages/peerjs-broker/
COPY apps/cli/package.json apps/cli/
COPY apps/web/package.json apps/web/
COPY lib lib
# npm ci resolves nothing: it installs exactly the committed lockfile (including
# each registry package's integrity hash) and fails if a manifest disagrees with
# it, so an image rebuild cannot drift from the tree CI tested. The root .npmrc
# copied in above puts the install-script policy in force here as it is locally
# and in CI; what that does and does not reach is in
# docs/spec/DEPENDENCY_PINS.md.
RUN --mount=type=cache,target=/root/.npm \
  npm ci -w packages/core -w packages/peerjs-broker -w apps/cli -w apps/web

COPY tsconfig.base.json tsconfig.json ./
COPY packages/core/*.ts packages/core/tsconfig.json packages/core/
COPY packages/core/src packages/core/src/
COPY apps/cli/tsconfig.json apps/cli/*.ts apps/cli/
COPY apps/cli/src apps/cli/src/
# @psilink/core must be built before the web build: apps/web consumes it from its
# built dist/ (a file: workspace dependency), so build core and the CLI first.
RUN npm run build -w packages/core -w apps/cli

COPY packages/peerjs-broker/tsconfig.json packages/peerjs-broker/
COPY packages/peerjs-broker/src packages/peerjs-broker/src/
COPY apps/web/vite.config.ts apps/web/nitro.config.ts apps/web/postcss.config.cjs apps/web/tsconfig.json apps/web/
COPY apps/web/src apps/web/src/
COPY apps/web/server apps/web/server/
COPY apps/web/public apps/web/public/
ARG VITE_DEPLOYMENT_PROFILE
ENV VITE_DEPLOYMENT_PROFILE=${VITE_DEPLOYMENT_PROFILE}
# The release version reaches this image's client bundle the same way it does
# the default image's (Dockerfile): read from the apps/cli manifest copied
# above, gated by `set -e`/`test -n` in the same RUN as the build so a failed
# read or an empty manifest value fails the layer rather than shipping a kit
# that quietly names the floating tag (apps/web/src/bench/acceptKit.ts).
RUN set -eu; \
  VITE_PSILINK_VERSION="$(node -p "require('/build/apps/cli/package.json').version ?? ''")"; \
  test -n "$VITE_PSILINK_VERSION"; \
  export VITE_PSILINK_VERSION; \
  npm run build -w apps/web

# The tree the runtime stage ships: the same lockfile-exact resolution as above
# with the build's own dependencies left out. The explicit wipe is what makes it
# production-only, `npm ci` emptying node_modules only when it is unscoped and
# reifying in place under the -w scoping here; --omit=optional rides beside
# --omit=dev because npm keeps a package flagged `devOptional`, which optional
# peer edges make of apps/web's vite. Measurements, and the one optional edge
# inside this scope, are in docs/spec/CONTAINER_IMAGES.md.
RUN --mount=type=cache,target=/root/.npm \
  rm -rf node_modules \
  && npm ci --omit=dev --omit=optional -w packages/core -w apps/cli

FROM nodebase

ARG AL2023_RELEASEVER
ARG FIPS_PROVIDER_PACKAGE
ARG FIPS_PROVIDER_VERSION
ARG FIPS_MODULE_VERSION

# samba-client provides smbclient for the Windows file-drop setup scripts'
# SMB probe, as apk add samba-client does in the root Dockerfile; the openssl
# CLI is what reads the loaded provider back in the build assertion below, which
# is the only reader of it -- the entrypoint's per-run report probes Node's own
# crypto instead, that being the consumer psilink actually runs on.
RUN dnf -y --releasever=${AL2023_RELEASEVER} install samba-client openssl && dnf clean all
# `swap`, not `install` or `downgrade`. The stock amazonlinux:2023 already ships
# openssl-fips-provider-latest at an uncertified 3.5.5, and its fips.so is the
# same file path: a plain install fails the transaction test on an RPM FILE
# conflict, which --allowerasing does not resolve, and removing the incumbent
# first takes openssl-libs (and with it dnf) out of the image, because both
# packages Provide the virtual openssl-libs requires. `swap` does both halves in
# one transaction.
RUN dnf -y --releasever=${AL2023_RELEASEVER} swap openssl-fips-provider-latest ${FIPS_PROVIDER_PACKAGE}-${FIPS_PROVIDER_VERSION} && dnf clean all
# The two assertions that make the certificate claim checkable rather than
# prose, each answering a question the other cannot. Which package put the
# module there -- asked of the installed fips.so itself rather than of the
# package database, so a second provider landing on that path is caught. And
# which module the loader actually activates -- which reports the certificate's
# module version string, and which runs the module's own integrity self-test as
# a side effect, since a fips.so whose bytes do not match its embedded MAC never
# reaches `status: active`.
#
# This awk is the only parse of `openssl list` output on either image's path --
# nothing that ships in an image or runs inside one reads that command back, the
# remaining parse in the repository being support/fips-probe/list-algorithms.sh,
# a harness that ships nowhere. It is safe here for two reasons the runtime is
# not: at build time the system OpenSSL is the right consumer, because what is
# being verified is the package just installed, and the parse is followed by an
# exact comparison against the pin, so any shape it reads wrongly fails the
# build rather than reporting an assurance. The exact comparison is what makes
# the block-anchored scan checkable: a fips block with no status line of its own
# yields the empty string, which is not the pinned value.
RUN set -eux; \
  owner="$(rpm -qf --qf '%{NAME} %{VERSION}-%{RELEASE}' /usr/lib64/ossl-modules/fips.so)"; \
  echo "installed FIPS module comes from: ${owner}"; \
  test "${owner}" = "${FIPS_PROVIDER_PACKAGE}-so ${FIPS_PROVIDER_VERSION}"; \
  reported="$(openssl list -providers -provider fips \
  | awk 'NF == 1 && index($1, ":") == 0 { seen = ($1 == "fips"); next } \
         seen && $1 == "version:" { version = $2 } \
         seen && $1 == "status:" { print version, $2; exit }')"; \
  echo "activated FIPS provider: ${reported}"; \
  test "${reported}" = "${FIPS_MODULE_VERSION} active"

# The account both roles run as, created rather than inherited: Amazon Linux
# 2023 carries no `node` account, the runtime here coming from the official
# tarball rather than from a package, so the uid and gid the default image gets
# from node:26-alpine are made by hand at the same 1000:1000 docs/DEPLOYMENT.md
# tells an operator to chown a bind mount to.
RUN groupadd --gid 1000 node && useradd --uid 1000 --gid node --create-home --home-dir /home/node node

# Every setuid and setgid bit the base and the package closure above carry
# between them, taken off. The USER below is what makes them matter: each of
# these account, mount and PAM helpers would otherwise be a boundary the
# unprivileged runtime account could push against, and neither role
# authenticates a Unix account or mounts a filesystem, so the bits buy the image
# nothing. image_smoke.yaml measures the built image's whole setuid/setgid
# inventory against the empty set this leaves, which is what catches a package
# that gains a bit or a transaction that lands one after this line; see
# docs/spec/CONTAINER_IMAGES.md.
RUN chmod u-s,g-s \
  /usr/bin/chage \
  /usr/bin/gpasswd \
  /usr/bin/mount \
  /usr/bin/newgrp \
  /usr/bin/su \
  /usr/bin/umount \
  /usr/bin/write \
  /usr/libexec/utempter/utempter \
  /usr/sbin/pam_timestamp_check \
  /usr/sbin/unix_chkpwd

# The package manager taken out of the final stage, as in the root Dockerfile:
# neither role runs npm, npx or corepack, and the npm CLI's bundled dependency
# tree is one no pin in this repository moves. The paths are under /opt/node,
# the runtime here coming from the official tarball rather than from a package,
# and this stage is the only one they leave -- the builder shares the `nodebase`
# stage and installs with the npm this would take from it. `rm -rf` on a path
# the tarball does not hold is a no-op.
RUN rm -rf \
  /opt/node/lib/node_modules/npm \
  /opt/node/lib/node_modules/corepack \
  /opt/node/bin/npm \
  /opt/node/bin/npx \
  /opt/node/bin/corepack

# Activates the FIPS and base providers and NOT the default provider, with
# fips=yes as the default property, so an algorithm the certified module does
# not carry fails rather than falling back to an uncertified implementation.
# Every dnf transaction above runs before this file is in force: the fips-only
# configuration breaks dnf's own Python, which hashes with blake2s.
COPY openssl-fips-only.cnf /etc/psilink/fips-only.cnf

WORKDIR /app
# npm links the workspaces its install names, so the tree copied here carries
# links to packages/core and apps/cli alone and both link targets are copied
# below. A link to a workspace this image does not ship would dangle, and
# image_smoke.yaml's symlink containment measurement refuses a dangling link
# under /app.
COPY --from=builder /build/node_modules node_modules
COPY --from=builder /build/packages/core/package.json packages/core/
COPY --from=builder /build/packages/core/dist packages/core/dist/
COPY --from=builder /build/apps/cli/package.json apps/cli/
COPY --from=builder /build/apps/cli/dist/index.js apps/cli/dist/index.js
# The PSI crypto worker entry must sit beside the CLI entry: psiWorkerHost.ts
# resolves it as `<__dirname>/psiWorker.worker.js`, and without it createPsiEngine
# silently falls back to the in-process engine.
COPY --from=builder /build/apps/cli/dist/psiWorker.worker.js apps/cli/dist/psiWorker.worker.js
COPY --from=builder /build/apps/web/.output apps/web/.output

ARG VITE_DEPLOYMENT_PROFILE
ENV VITE_DEPLOYMENT_PROFILE=${VITE_DEPLOYMENT_PROFILE}
ENV JOB_CLI_BINARY=/app/apps/cli/dist/index.js

# The pinned module version, carried into the image so the entrypoint can name
# the module without reading one back. The assertion above has already compared
# this value against what the installed module reports, so inside the image it
# is a fact about the build rather than a claim about the run.
ENV FIPS_MODULE_VERSION=${FIPS_MODULE_VERSION}

EXPOSE 3000

# Two scripts: the FIPS preamble reports the provider and the host's FIPS-mode
# state and then hands off to the same dispatch script the default image runs,
# so both images accept the same CLI and `serve` invocations.
COPY docker-entrypoint.sh docker-entrypoint-fips.sh /app/
RUN chmod +x /app/docker-entrypoint.sh /app/docker-entrypoint-fips.sh

# The engagement probe the preamble runs at every container start, and the
# module holding its legs. Only these two files of support/fips-probe/ ship:
# the rest of that directory builds OpenSSL from source and deliberately
# corrupts a provider, which is a measurement harness rather than anything a
# runtime image should carry.
COPY support/fips-probe/engagement.mjs support/fips-probe/image-engagement.mjs /app/fips-probe/

ENV OPENSSL_CONF=/etc/psilink/fips-only.cnf
ENV OPENSSL_MODULES=/usr/lib64/ossl-modules

# Everything the container must WRITE, created and handed to the unprivileged
# account the USER below drops to, exactly as in the root Dockerfile: /work so a
# run with no bind mount still has somewhere to write, and /run/psilink for the
# console's pasted-credential scratch directory, whose root-owned parent an
# unprivileged server cannot create at boot. /app is deliberately not among
# them, so the running process reads and executes its own code without being
# able to rewrite it.
RUN mkdir -p /work /run/psilink/sftp-credentials \
  && chown -R node:node /work /run/psilink \
  && chmod -R 700 /run/psilink

# Stated rather than left to the runtime's passwd lookup, as in the root
# Dockerfile: the CLI derives its default signing-identity directory from the
# home directory while its module loads, ahead of any command.
ENV HOME=/home/node

# Drop to the account created above for both roles, after every COPY and RUN so
# those still build as root and /app stays root-owned, and before the WORKDIR
# below so the ENTRYPOINT inherits it. The preamble the ENTRYPOINT runs needs no
# privilege either: it reads /proc/sys/crypto/fips_enabled and runs a probe.
USER node

WORKDIR /work

ENTRYPOINT ["/app/docker-entrypoint-fips.sh"]
