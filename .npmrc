# Make the root engines.node constraint a hard install failure rather than npm's
# default advisory warning, so CI, the docs, and a local install cannot diverge
# on the Node version.
engine-strict=true

# Make a package with no `allowScripts` verdict a hard install failure rather
# than npm's advisory warning, so an unreviewed install script cannot run first
# and be noticed after. Safe to set because the map covers every install script
# the committed lockfile records -- completeness that
# scripts/allow-scripts-policy.test.mjs holds as a check rather than prose.
strict-allow-scripts=true
