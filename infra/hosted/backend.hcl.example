# Copy to backend.hcl, which is gitignored, and pass it at init:
#   tofu init -backend-config=backend.hcl
# The bucket is the operator's own: private, versioned, and encrypted at rest,
# because the state holds every value in terraform.tfvars.

bucket       = "<state bucket name>"
key          = "alcove/hosted/terraform.tfstate"
region       = "us-west-2"
encrypt      = true
use_lockfile = true
