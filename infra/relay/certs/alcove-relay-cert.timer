[Unit]
Description=Renew the Alcove relay's TLS certificate daily

[Timer]
# Daily, because the ACME client renews only inside its window. The deploy hook
# runs every day too, and restarts the relay only on a day the certificate or
# key changed; the fixed early hour is when that restart is least likely to land
# on an exchange in flight. The randomized delay keeps several relays off the
# same second at the authority.
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
