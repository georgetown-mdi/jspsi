# Copy to /etc/psilink-relay/acme.env on the relay host and fill it in.
#
#   install -m 600 env.example /etc/psilink-relay/acme.env
#
# It carries a DNS provider credential, so it is mode 600 and untracked. Nothing
# here defaults: renew.sh refuses to run without the file.

# The contact the certificate authority requires. It receives the expiry warnings
# that are the backstop when the renewal timer stops running.
PSILINK_RELAY_ACME_EMAIL=

# lego (default) or acme.sh. Both are driven the same way by renew.sh; neither is
# installed by install.sh, because which one a host already carries is the
# operator's choice. lego must be v5 or later: renew.sh's invocation uses the v5
# `run` flag shape, which a v4 binary rejects.
PSILINK_RELAY_ACME_CLIENT=lego

# The DNS-01 provider, as the ACME client names it. Changing this and the
# credential block below is the whole of moving to another DNS host or another
# cloud -- nothing else in this directory knows who serves the zone.
PSILINK_RELAY_DNS_PROVIDER=cloudflare

# The provider's own credential, in the variables that provider's plugin reads.
# Cloudflare's DNS-01 plugin reads a token scoped to Zone:DNS:Edit on the one
# zone that holds the relay's name -- not a global key, which would carry every
# zone on the account into this file.
CLOUDFLARE_DNS_API_TOKEN=
