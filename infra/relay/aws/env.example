# Copy to `env` beside this file and fill it in.
#
#   chmod 600 env
#
# demo-up.sh and demo-down.sh read it and refuse to run without it: a demo
# script that guessed an instance id would stop or start whatever it guessed at.
# The real file is untracked.

# The always-on demo box, which carries the demo SFTP server and nothing else.
# The standing relay does NOT live here -- it has a dedicated instance of its own
# (see provision.md), and these scripts must never be pointed at it.
PSILINK_DEMO_INSTANCE_ID=
PSILINK_DEMO_REGION=
PSILINK_DEMO_PROFILE=

# Optional. With a zone and a token scoped to Zone:DNS:Edit on it, demo-up.sh
# re-points this A record at the address the instance came back on. Without them
# it prints the address and leaves DNS alone, and whoever needs the demo gets the
# address by hand.
#
# A stopped and started instance returns on a different public address unless an
# elastic address is held for it, and an address held for a stopped instance
# bills for every hour it is idle -- which is what these scripts exist to avoid.
# Re-pointing a short-TTL record is the cheaper half of that trade.
PSILINK_DEMO_DNS_NAME=
CF_ZONE_NAME=
CF_DNS_API_TOKEN=
