# Quadlet unit for the psilink standing relay, used where the host has podman.
# install.sh puts this at /etc/containers/systemd/psilink-relay.container, where
# podman's systemd generator turns it into psilink-relay.service at
# daemon-reload.
#
# systemd is the only supervisor: there is no container daemon under this, and
# nothing restarts the relay except the unit below.
#
# PAIRED WITH psilink-relay-docker.service, which install.sh uses instead on a
# host that has docker and no podman -- Amazon Linux 2023 among them. The two
# carry the same image, the same mounts, and the same container flags; edit them
# together. That file's header carries the directive-to-flag mapping.

[Unit]
Description=psilink WebRTC relay (coturn, TURNS on 443/tcp)
Documentation=https://github.com/georgetown-mdi/jspsi/blob/main/infra/relay/README.md
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=psilink-relay

# The tag install.sh builds from this directory's Dockerfile, which is where the
# base digest is pinned. Nothing here names a registry image or a floating tag.
Image=localhost/psilink-relay:installed

# TURN's relay port range and its NAT behaviour do not survive bridge networking
# or published ports: coturn hands out a relayed transport address that the
# translation would rewrite, and the range is wide enough that publishing it is
# not a port list. Host networking is a requirement of the protocol here, not a
# convenience.
Network=host

# The rendered configuration carries the static authentication secret and is
# mounted read-only. The certificate directory is what the ACME deploy hook
# writes and what coturn re-reads on restart.
Volume=/etc/psilink-relay/turnserver.conf:/etc/coturn/turnserver.conf:ro
Volume=/etc/psilink-relay/certs:/etc/coturn/certs:ro

Exec=-c /etc/coturn/turnserver.conf

# no-new-privileges is deliberately absent: the image's entrypoint acquires
# cap_net_bind_service at exec, which that flag forbids -- measured on the live
# relay 2026-09-03 (with the flag, an errno-13 bind loop on 443; without it, the
# listener is up in seconds). DropCapability/AddCapability remains the control
# that bounds the acquisition.
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
ReadOnly=true
Tmpfs=/var/tmp
LogDriver=journald

[Service]
# Rendered on every start, not only at install: the instance's public address is
# not a property of the installation, and a stale external-ip advertises a
# relayed candidate nobody can reach.
ExecStartPre=/opt/psilink-relay/render-config.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
