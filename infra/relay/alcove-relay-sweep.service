# The hourly sweep of lapsed exchange keys (README.md, Per-exchange keys).
# install.sh renders this to /etc/systemd/system/, filling in the relay image's
# uid and gid; it runs as that account, which owns the secrets table, under the
# registrar's sandbox with no network.

[Unit]
Description=Revoke the Alcove relay's lapsed exchange keys
Documentation=https://github.com/georgetown-mdi/alcove/blob/main/infra/relay/README.md

[Service]
Type=oneshot
EnvironmentFile=/etc/alcove-relay/relay.env
ExecStart=/usr/bin/python3 -B /opt/alcove-relay/relay_table.py sweep
StandardInput=null
User=__ALCOVE_RELAY_IMAGE_UID__
Group=__ALCOVE_RELAY_IMAGE_GID__

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/alcove-relay
ProtectKernelTunables=true
RestrictSUIDSGID=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
PrivateDevices=true
PrivateNetwork=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RemoveIPC=true
UMask=0077
