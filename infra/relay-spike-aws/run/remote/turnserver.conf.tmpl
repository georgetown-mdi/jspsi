# coturn for the relay spike, one cycle. TURNS (TLS) on 443/tcp is the transport
# a restrictive network leaves open; plain TURN on 3478 is the unrestricted
# baseline. Substituted by services-up.sh: __IP_TURN__, __EIP_TURN__,
# __SECRET__, __REALM__.
listening-port=3478
tls-listening-port=443
listening-ip=__IP_TURN__
relay-ip=__IP_TURN__
external-ip=__EIP_TURN__/__IP_TURN__
min-port=49152
max-port=49200
fingerprint
use-auth-secret
static-auth-secret=__SECRET__
realm=__REALM__
cert=/etc/coturn/certs/turn.crt
pkey=/etc/coturn/certs/turn.key
verbose
log-file=stdout
simple-log
no-cli
no-multicast-peers
no-tlsv1
no-tlsv1_1
