# The TLS front for the web app and the broker it mounts at /api. Bound to the
# web address only, so coturn keeps 443 on the turn address of the same instance.
# Substituted by services-up.sh: __IP_WEB__, __WEB_HOST__.
events {}
http {
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen __IP_WEB__:443 ssl;
    server_name __WEB_HOST__;
    ssl_certificate /etc/nginx/certs/web.crt;
    ssl_certificate_key /etc/nginx/certs/web.key;
    location / {
      proxy_pass http://127.0.0.1:3000;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_read_timeout 3600s;
    }
  }
}
