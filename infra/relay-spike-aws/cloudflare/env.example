# Copy to `env` beside this file and fill in what you have. Every script branches
# on presence: with no file at all the run uses the private CA and raw addresses,
# exactly as question 1 ran, and reports the managed-relay row as not measured.
#
#   chmod 600 env
#
# The zone and a token scoped to Zone:DNS:Edit on that zone. With these, the run
# creates DNS-only A records for spike-turn.<zone> and spike-web.<zone> and
# issues ONE Let's Encrypt certificate by DNS-01, reused across cycles.
CF_ZONE_NAME=
CF_DNS_API_TOKEN=

# A Cloudflare Realtime TURN key and its API token. With these, question 3's
# managed-relay rows run; without them they are reported "not measured".
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
