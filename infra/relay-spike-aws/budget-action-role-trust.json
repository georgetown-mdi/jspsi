{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "Service": "budgets.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "REPLACE_WITH_YOUR_ACCOUNT_ID" },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:budgets::REPLACE_WITH_YOUR_ACCOUNT_ID:budget/*"
        }
      }
    }
  ]
}
